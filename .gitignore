node_modules/
.vercel

# The Instagram export is the raw download; source/ is the normalised copy that
# actually gets committed, so the export itself is redundant in git.
export/

# Derived image layers ARE committed. They are the build cache: Vercel clones a
# fresh checkout every deploy, so anything not in git is rebuilt from scratch, and
# rebuilding 149 sheets takes minutes. With them committed, a deploy that only
# changed meta.json or a note finishes in well under a second.
#
# Video is the exception — it is copied straight out of source/, so committing it
# would duplicate 17MB to save 350ms.
public/art/video/

# Generated on every build, in milliseconds.
public/list.html
public/notes.html
