{
  "name": "medi-wall",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "An infinite wall of taped-up drawings.",
  "scripts": {
    "ingest": "node scripts/ingest.mjs export/tiredmedi source",
    "build": "node scripts/build.mjs source public/art",
    "all": "npm run ingest && npm run build",
    "tag-eyes": "node scripts/tag-eyes.mjs source public/art",
    "placeholders": "node scripts/make-placeholders.mjs source 12",
    "test": "node --test test/",
    "dev": "node scripts/serve.mjs"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "sharp": "^0.35.0"
  }
}
